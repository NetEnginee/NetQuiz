# Prevent directory listing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Block execution of PHP or executable scripts inside uploads directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
